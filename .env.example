DATABASE_URL=postgres://paperclip:paperclip@localhost:5432/paperclip
PORT=3100
SERVE_UI=false
BETTER_AUTH_SECRET=paperclip-dev-secret
PAPERCLIP_TOOL_ACTION_SIGNING_SECRET=paperclip-dev-tool-action-signing-secret-change-me

# Discord webhook for daily merge digest (scripts/discord-daily-digest.sh)

# Optional SDLC workflow observability sinks. Use test-scoped operator-injected
# values only; never commit credentials or DSNs with active project keys.
# PAPERCLIP_SDLC_ENVIRONMENT=test
# PAPERCLIP_SDLC_LOKI_URL=https://logs-prod-XXX.grafana.net
# PAPERCLIP_SDLC_LOKI_USER=123456
# PAPERCLIP_SDLC_LOKI_TOKEN=<operator-injected-secret>
# PAPERCLIP_SDLC_SENTRY_DSN=https://<public-key>@<ingest-host>/<project-id>

# The runtime emits only allowlisted SDLC correlation metadata. It never emits
# issue text, document bodies, request/provider payloads, or raw exceptions.

# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
